ROWS[99] = "000000000000000000000000000000000013222320303023202333333333202320303023222310000000000000000000000000000000000";
ROWS[100] = "000000000000000000000000000000000000130323232320233333333333332023232323031000000000000000000000000000000000000";
ROWS[101] = "000000000000000000000000000000000000001130303023333333333333333320303031100000000000000000000000000000000000000";
ROWS[102] = "000000000000000000000000000000000000000001122333333333333333333333221100000000000000000000000000000000000000000";
DIG["0"] = 0; DIG["1"] = 1; DIG["2"] = 2; DIG["3"] = 3;
LOADED = 0;                   # rows read into the arrays so far
REVEAL = 0;                   # frames of the opening so far, -1 when it is done

# a few rows a frame, so the first frame does not wait for all of them
fun load_rows(n) {
    local.r = 0;
    local.x = 0;
    local.i = 0;
    local.v = 0;
    for (r = LOADED; r < LOADED + n && r < G; r++) {
        for (x = 0; x < G; x++) {
            i = r * G + x;
            v = 0;
            if (ROWS[r]) v = DIG[ROWS[r].CharAt(x)];
            HT[i] = v; BH[i] = v; DS[i] = v; DF[i] = 0; HOTT[i] = 0;
        }
    }
    global.LOADED = r;
}

fun mark(i) {
    if (!DF[i]) { DF[i] = 1; DIRTY[DIRTY.n] = i; DIRTY.n++; }
}

fun push(i) {
    Q[(QH + QN) % QMAX] = i;
    global.QN = QN + 1;
}

fun add(i, n) {
    local.was = HT[i];
    HT[i] = was + n;
    mark(i);
    if (was < 4 && HT[i] >= 4) push(i);
}

# one toppling of the cell at the front of the queue
fun topple() {
    local.i = Q[QH];
    local.x = 0;
    local.y = 0;
    local.c = 0;
    global.QH = (QH + 1) % QMAX;
    global.QN = QN - 1;
    if (HT[i] < 4) return 0;
    HT[i] = HT[i] - 4;
    if (HT[i] >= 4) push(i);
    HOTT[i] = FRAME + HOTF;
    c = (FRAME + HOTF) % 16;
    COOL[c][COOL[c].n] = i;
    COOL[c].n++;
    mark(i);
    x = i % G;
    y = Math.Int(i / G);
    # grains that go over the edge are lost
    if (x > 0) add(i - 1, 1);
    if (x < G - 1) add(i + 1, 1);
    if (y > 0) add(i - G, 1);
    if (y < G - 1) add(i + G, 1);
    return 1;
}

fun cool() {
    local.c = FRAME % 16;
    local.k = 0;
    local.i = 0;
    for (k = 0; k < COOL[c].n; k++) {
        i = COOL[c][k];
        if (HOTT[i] <= FRAME) mark(i);
    }
    COOL[c] = NULL;
    COOL[c].n = 0;
}

fun redraw() {
    local.k = 0;
    local.i = 0;
    local.d = 0;
    for (k = 0; k < DIRTY.n; k++) {
        i = DIRTY[k];
        DF[i] = 0;
        if (HOTT[i] > FRAME) d = 4;
        else {
            d = HT[i];
            if (d > 3) d = 3;
        }
        if (d == DS[i]) continue;
        DS[i] = d;
        if (d == BH[i]) {
            if (OV[i]) global.OVN = OVN - 1;
            OV[i] = NULL;
            continue;
        }
        if (OV[i]) OV[i].SetImage(CELLIMG[d]);
        else {
            OV[i] = Sprite(CELLIMG[d]);
            OV[i].SetPosition(OX + (i % G) * CSZ, OY + Math.Int(i / G) * CSZ, 5);
            global.OVN = OVN + 1;
        }
    }
    DIRTY.n = 0;
}

# the pile opens from the middle row outwards
fun reveal() {
    local.h = BASEIMG.GetHeight();
    local.half = Math.Int(h / 2);
    local.k = (REVEAL + 1) * 2 * CSZ;
    if (k >= half || !HAVE_CROP) {
        BASE.SetImage(BASEIMG);
        BASE.SetPosition(BX, BY, 4);
        global.REVEAL = -1;
        return;
    }
    BASE.SetImage(BASEIMG.Crop(0, half - k, BASEIMG.GetWidth(), 2 * k));
    BASE.SetPosition(BX, BY + half - k, 4);
    global.REVEAL = REVEAL + 1;
}

fun tick() {
    local.used = 0;
    local.drops = 0;
    local.budget = Math.Int(15000 / (OVN + 200));
    if (budget > BUDGET) budget = BUDGET;
    if (budget < 2) budget = 2;
    while (used < budget) {
        if (QN == 0) {
            if (AVAL > BIGGEST) global.BIGGEST = AVAL;
            global.AVAL = 0;
            if (drops >= 2 || HALT) break;
            add(CENTER, 1);
            global.GRAINS++;
            drops++;
            continue;
        }
        if (topple()) {
            used++;
            global.TOPPLES++;
            global.AVAL++;
        }
    }
}

# ---- readout --------------------------------------------------------------------
fun commas(n) {
    local.s = "";
    if (n < 1000) return "" + n;
    s = "" + (n % 1000);
    while (s.Length() < 3) s = "0" + s;
    return commas(Math.Int(n / 1000)) + "," + s;
}

SHOWN = "";
fun readout() {
    local.s = "sandpile · grains " + commas(GRAINS) + " · topplings " + commas(TOPPLES) +
              " · largest avalanche " + commas(BIGGEST);
    if (s == SHOWN) return;
    global.SHOWN = s;
    global.READ_R = txt_run("lo", s, SX + MARGIN, SY + Math.Int(FLH * 0.8), 50);
}

# ---- passphrase hooks -----------------------------------------------------------------
fun hook_prompt() { }
PEND = 0;                     # grains dropped before the pile was read in
fun drop(k) {
    if (LOADED < G) global.PEND = PEND + k;
    else add(CENTER, k);
    global.GRAINS = GRAINS + k;
}
fun hook_key(n) {
    # a pinch of four grains onto the middle
    drop(4);
}
fun hook_erase(n) { }
fun hook_wrong() {
    # a whole sack onto the middle
    drop(120);
}
fun hook_enter() { }
fun hook_question() { }

# ---- power-off: the wind takes the sand, from one side ----------------------------------
fun wind() {
    local.k = 0;
    local.y = 0;
    local.x = 0;
    local.i = 0;
    for (k = 0; k < Math.Int(G / 4); k++) {
        y = Math.Int(rnd() * G);
        for (x = 0; x < G; x++) {
            i = y * G + x;
            if (HT[i] > 0) { HT[i] = HT[i] - 1; mark(i); break; }
        }
    }
}

if (HALT) {
    if (MODE == "reboot") NIGHT_R = pr_line("lo", "see you soon.", PR.y1);
    else NIGHT_R = pr_line("lo", "good night.", PR.y1);
}

# ---- main loop --------------------------------------------------------------------------
fun refresh() {
    global.FRAME++;
    if (LOADED < G) load_rows(6);
    if (REVEAL >= 0) reveal();
    else if (LOADED >= G) {
        if (PEND > 0) { add(CENTER, PEND); global.PEND = 0; }
        if (HALT) { if (FRAME > 50) wind(); }
        else tick();
    }
    cool();
    redraw();
    if (FRAME % 10 == 0) readout();
    prompt_tick();
}

readout();
prompt_setup();
Plymouth.SetRefreshFunction(refresh);
