# Turn a string into an array of CP437 codes (out.n = length). out.off[k] is
# the byte offset where glyph k starts, out.off[out.n] the length in bytes:
# Plymouth's string functions count bytes, and "•" alone is three of them.
fun txt_codes(s) {
    local.out.n = 0;
    local.i = 0;
    local.k = 0;
    local.c = s.CharAt(0);
    while (c != "") {
        out.off[out.n] = i;
        k = TXT.ord[c];
        if (k) { out[out.n] = k; out.n++; i++; }
        else {
            k = TXT.u8[s.SubString(i, i + 3)];
            if (k) { out[out.n] = k; out.n++; i += 3; }
            else {
                k = TXT.u8[s.SubString(i, i + 2)];
                if (k) { out[out.n] = k; out.n++; i += 2; }
                else { out[out.n] = 63; out.n++; i++; }
            }
        }
        c = s.CharAt(i);
    }
    out.off[out.n] = i;
    return out;
}

# Number of glyphs a string renders to.
fun txt_len(s) {
    local.c = txt_codes(s);
    return c.n;
}

# Load a font atlas. fid: short id, file: atlas PNG, cw/ch: atlas cell size,
# adv: horizontal advance, lh: line height, pad: glow margin around each glyph.
FONT.count = 0;     # must exist at top level so functions see the globals
GLYPH.count = 0;

fun font_load(fid, file, cw, ch, adv, lh, pad) {
    global.FONT[fid].atlas = Image(file);
    global.FONT[fid].cw = cw;
    global.FONT[fid].ch = ch;
    global.FONT[fid].adv = adv;
    global.FONT[fid].lh = lh;
    global.FONT[fid].pad = pad;
}

fun glyph(fid, code) {
    if (!GLYPH[fid][code])
        global.GLYPH[fid][code] = FONT[fid].atlas.Crop((code % 16) * FONT[fid].cw,
                                                Math.Int(code / 16) * FONT[fid].ch,
                                                FONT[fid].cw, FONT[fid].ch);
    return GLYPH[fid][code];
}

# Create sprites for a string at (x, y). Returns a run object; drop it to erase.
fun txt_run(fid, s, x, y, z) {
    local.codes = txt_codes(s);
    local.r.n = codes.n;
    local.r.w = codes.n * FONT[fid].adv;
    local.r.x = x;
    local.r.y = y;
    local.i = 0;
    for (i = 0; i < codes.n; i++) {
        if (codes[i] != 32) {
            r.sp[i] = Sprite(glyph(fid, codes[i]));
            r.sp[i].SetPosition(x + i * FONT[fid].adv - FONT[fid].pad, y - FONT[fid].pad, z);
        }
    }
    return r;
}

# Same, from an already decoded code array (from index a, count n).
fun txt_run_codes(fid, codes, a, n, x, y, z) {
    local.r.n = n;
    local.r.w = n * FONT[fid].adv;
    local.r.x = x;
    local.r.y = y;
    local.i = 0;
    for (i = 0; i < n; i++) {
        if (codes[a + i] != 32) {
            r.sp[i] = Sprite(glyph(fid, codes[a + i]));
            r.sp[i].SetPosition(x + i * FONT[fid].adv - FONT[fid].pad, y - FONT[fid].pad, z);
        }
    }
    return r;
}

fun run_opacity(r, o) {
    local.i = 0;
    for (i = 0; i < r.n; i++) if (r.sp[i]) r.sp[i].SetOpacity(o);
}

fun run_move(r, x, y) {
    local.i = 0;
    local.fid = 0;
    for (i = 0; i < r.n; i++)
        if (r.sp[i]) r.sp[i].SetPosition(x + (r.sp[i].GetX() - r.x), y + (r.sp[i].GetY() - r.y), r.sp[i].GetZ());
    r.x = x;
    r.y = y;
}

# Shorten s to at most n glyphs by cutting out the middle, at glyph
# boundaries, so a multi-byte character is never split.
fun txt_fit(s, n) {
    local.c = txt_codes(s);
    local.h = 0;
    if (c.n <= n) return s;
    if (n < 5) return s.SubString(0, c.off[n]);
    h = Math.Int((n - 3) / 2);
    return s.SubString(0, c.off[h]) + "..." + s.SubString(c.off[c.n - (n - 3 - h)], c.off[c.n]);
}

# Uniform random number in [0, 1). Plymouth 24's Math.Random() returns values
# scaled down by 2^32; normalise so this also works if that ever gets fixed.
fun rnd() {
    local.r = Math.Random();
    if (r < 0.000001) r = r * 4294967296;
    return r - Math.Int(r);
}

# Pick the largest integer scale (from 1..maxs) at which a cols x rows grid of
# (cw x lh) cells still fits into w x h.
fun pick_scale(w, h, cw, lh, cols, rows, maxs) {
    local.s = maxs;
    while (s > 1 && (cols * cw * s > w || rows * lh * s > h)) s--;
    return s;
}


#==============================================================================
# passphrase, question and message handling, shared by the newer themes
#
# Before prompt_setup() the theme sets
#   PR.hi, PR.lo, PR.err   font ids: entry, prompt and messages, warnings
#   PR.y0 .. PR.y3         top of the lines: warning, prompt, entry, caps lock
#   PR.cx                  centre x of the text (PR.align = "center"), or
#   PR.left                left edge (PR.align = "left")
#   PR.maxc                most glyphs on a line
#   PR.adv                 glyph advance in px
#   PR.z                   z of the text
# and defines all of these hooks (empty bodies are fine):
#   hook_prompt()          a passphrase prompt appeared
#   hook_wrong()           the same prompt came back: the passphrase was wrong
#   hook_key(n)            a character was typed, n characters now
#   hook_erase(n)          a character was deleted
#   hook_enter()           Enter: the passphrase went to the disk
#   hook_question()        a question appeared
# Its refresh function calls prompt_tick() once per frame.
#==============================================================================
PR.wrong = "wrong. try again.";
PR.caps_text = "caps lock";
PR.align = "center";
PR.z = 50;
P.active = 0;          # 0 none, 1 passphrase, 2 question
P.bullets = -1;
P.prompt = "";
P.last = "";
P.answered = 0;
P.err = 0;
P.blink = 0;
P.caps = 0;
P.msg = 0;

fun nearest(list, v) {
    local.best = 999999;
    local.r = list[0];
    local.i = 0;
    for (i = 0; i < list.n; i++)
        if (Math.Abs(list[i] - v) < best) { best = Math.Abs(list[i] - v); r = list[i]; }
    return r;
}

# Pick the LM Mono size for this screen and load the given font ids.
fun lm_load(ids, target) {
    local.i = 0;
    global.FS = nearest(FSL, target);
    for (i = 0; i < FSL.n; i++) if (FSL[i] == FS) { global.FADV = FSA[i]; global.FLH = FSH[i]; }
    for (i = 0; i < ids.n; i++)
        font_load(ids[i], "font-" + ids[i] + "-" + FS + ".png", FADV, FLH, FADV, FLH, 0);
}

# The four text lines at the bottom of the screen, centred.
fun prompt_bottom(cx, maxw) {
    PR.cx = cx;
    PR.adv = FADV;
    PR.maxc = Math.Int(maxw / FADV);
    PR.y3 = SY + SH - Math.Int(FLH * 1.3);
    PR.y2 = PR.y3 - FLH;
    PR.y1 = PR.y2 - Math.Int(FLH * 1.05);
    PR.y0 = PR.y1 - Math.Int(FLH * 1.05);
}

fun pr_x(n) {
    if (PR.align == "left") return PR.left;
    return PR.cx - Math.Int(n * PR.adv / 2);
}

fun pr_line(fid, s, y) {
    local.t = txt_fit(s, PR.maxc);
    return txt_run(fid, t, pr_x(txt_len(t)), y, PR.z);
}

fun pr_entry(s) {
    local.t = txt_fit(s, PR.maxc - 2);
    local.x = pr_x(txt_len(t) + 1);
    global.PR_ENTRY = txt_run(PR.hi, t, x, PR.y2, PR.z);
    global.PR_CURSOR = txt_run(PR.hi, "_", x + txt_len(t) * PR.adv, PR.y2, PR.z);
}

fun on_password(prompt, bullets) {
    local.s = "";
    local.i = 0;
    local.n = 0;
    if (P.active != 1) {
        global.PR_MSG = NULL;
        P.msg = 0;
        if (P.answered && prompt == P.last) {
            P.err = 220;
            global.PR_ERR = NULL;
            hook_wrong();
        } else {
            hook_prompt();
        }
        P.active = 1;
        P.prompt = prompt;
        P.bullets = -1;
        if (prompt == "") prompt = "passphrase:";
        global.PR_PROMPT = pr_line(PR.lo, prompt, PR.y1);
    }
    if (bullets != P.bullets) {
        if (P.bullets >= 0) {
            if (bullets > P.bullets) hook_key(bullets);
            else hook_erase(bullets);
        }
        P.bullets = bullets;
        n = bullets;
        if (n > 40) n = 40;
        for (i = 0; i < n; i++) s = s + "• ";
        pr_entry(s);
    }
}

fun on_question(prompt, entry) {
    if (P.active != 2) {
        P.active = 2;
        P.err = 0;
        global.PR_ERR = NULL;
        global.PR_MSG = NULL;
        global.PR_PROMPT = pr_line(PR.lo, prompt, PR.y1);
        hook_question();
    }
    pr_entry(entry);
}

fun on_normal() {
    if (P.active == 1) {
        P.answered = 1;
        P.last = P.prompt;
        hook_enter();
    }
    P.active = 0;
    P.bullets = -1;
    global.PR_PROMPT = NULL;
    global.PR_ENTRY = NULL;
    global.PR_CURSOR = NULL;
    global.PR_CAPS = NULL;
    P.caps = 0;
}

fun on_message(text) {
    if (P.active) return;
    global.PR_MSG = pr_line(PR.lo, text, PR.y1);
    P.msg = 250;
}

fun on_hide_message(text) {
    global.PR_MSG = NULL;
    P.msg = 0;
}

fun prompt_tick() {
    if (P.active) {
        P.blink = (P.blink + 1) % 50;
        if (PR_CURSOR) run_opacity(PR_CURSOR, P.blink < 25);
        if (P.active == 1 && P.blink % 10 == 0) {
            if (Plymouth.GetCapslockState()) {
                if (!P.caps) global.PR_CAPS = pr_line(PR.err, PR.caps_text, PR.y3);
                P.caps = 1;
            } else {
                P.caps = 0;
                global.PR_CAPS = NULL;
            }
        }
    }
    if (P.err > 0) {
        if (!PR_ERR) global.PR_ERR = pr_line(PR.err, PR.wrong, PR.y0);
        P.err--;
        if (P.err < 30) run_opacity(PR_ERR, P.err / 30);
        if (P.err == 0) global.PR_ERR = NULL;
    }
    if (P.msg > 0) {
        P.msg--;
        if (P.msg == 0) global.PR_MSG = NULL;
    }
}

fun prompt_setup() {
    Plymouth.SetDisplayPasswordFunction(on_password);
    Plymouth.SetDisplayQuestionFunction(on_question);
    Plymouth.SetDisplayNormalFunction(on_normal);
    Plymouth.SetDisplayMessageFunction(on_message);
    Plymouth.SetHideMessageFunction(on_hide_message);
}

FSL[0] = 14; FSA[0] = 7; FSH[0] = 23;
FSL[1] = 17; FSA[1] = 9; FSH[1] = 28;
FSL[2] = 20; FSA[2] = 10; FSH[2] = 32;
FSL[3] = 24; FSA[3] = 13; FSH[3] = 38;
FSL[4] = 28; FSA[4] = 15; FSH[4] = 44;
FSL[5] = 34; FSA[5] = 18; FSH[5] = 53;
FSL[6] = 40; FSA[6] = 21; FSH[6] = 62;
FSL.n = 7;
NOISE_N = 32;
HOT_N = 12;

MODE = Plymouth.GetMode();
HALT = (MODE == "shutdown" || MODE == "reboot");

# ---- text ---------------------------------------------------------------------
IDS[0] = "hi"; IDS[1] = "lo"; IDS[2] = "err"; IDS[3] = "ax"; IDS.n = 4;
lm_load(IDS, SH / 52);
prompt_bottom(SX + SW / 2, SW * 0.9);
PR.hi = "hi"; PR.lo = "lo"; PR.err = "err";
MARGIN = Math.Int(FADV * 2);

# ---- layout ---------------------------------------------------------------------
F0 = 433.05;
F1 = 434.79;
WX0 = SX + Math.Int(SW * 0.05);
WX1 = SX + Math.Int(SW * 0.95);
WW = WX1 - WX0;
SPY0 = SY + Math.Int(FLH * 2.4);             # spectrum
SPY1 = SPY0 + Math.Int(SH * 0.16);
AXY = SPY1 + Math.Int(FLH * 0.35);            # frequency axis
WY0 = AXY + Math.Int(FLH * 1.6);              # waterfall
WY1 = PR.y0 - FLH;
RH = Math.Max(2, Math.Int(SH / 540));         # row height
NROWS = Math.Int((WY1 - WY0) / RH);
WY1 = WY0 + NROWS * RH;

fun fx(f) { return WX0 + (f - F0) / (F1 - F0) * WW; }

# ---- images ---------------------------------------------------------------------------
for (i = 0; i < NOISE_N; i++) NOISE[i] = Image("noise-" + i + ".png").Scale(WW, RH);
for (i = 0; i < HOT_N; i++) HOTN[i] = Image("hot-" + i + ".png").Scale(WW, RH);
CW = Math.Max(3, Math.Int(SW / 400));
CARRIER = Image("carrier.png").Scale(CW * 3, RH);
CARRIER_W = Image("carrier-weak.png").Scale(CW * 3, RH);
LORA_BW = fx(F0 + 0.25) - fx(F0);             # 250 kHz in px
SYM = 12;                                      # rows per chirp
CHIRP = Image("chirp.png").Scale(Math.Int(LORA_BW / SYM) + CW * 2, RH);
CHW = CHIRP.GetWidth();
FSK = Image("carrier.png").Scale(CW * 2, RH);

# ---- frame: axis, ticks, passband marker -------------------------------------------------
fun axis() {
    local.f = 433.1;
    local.s = "";
    local.x = 0;
    local.k = 0;
    while (f < F1) {
        x = fx(f);
        TICK[k] = Sprite(Image("tick.png").Scale(1, Math.Int(FLH * 0.3)));
        TICK[k].SetPosition(x, SPY1, 6);
        s = "" + f;
        if (s.Length() < 7) s = s + "0";
        if (s.Length() < 7) s = s + "0";
        AXL[k] = txt_run("ax", s, x - Math.Int(txt_len(s) * FADV / 2), AXY, 50);
        k++;
        f = f + 0.2;
    }
}
TICK.n = 0;
AXL.n = 0;
axis();
UNIT_R = txt_run("ax", "MHz", WX1 - 3 * FADV, AXY, 50);

LORA_F = 433.92;
LX0 = fx(LORA_F - 0.125);
PASS = Sprite(Image("pass.png").Scale(Math.Int(LORA_BW), WY1 - SPY0));
PASS.SetPosition(LX0, SPY0, 6);
PASS_L = txt_run("ax", "433.920 · LoRa 250 kHz", LX0, SPY0 - FLH, 50);

# ---- spectrum: bars of 16 heights ---------------------------------------------------------
NB = 128;
BW_ = WW / NB;
BAR_IMG = Image("bar.png");
for (i = 0; i < 16; i++) BARS[i] = BAR_IMG.Scale(Math.Max(1, Math.Int(BW_) - 1), Math.Max(1, Math.Int((SPY1 - SPY0) * (i + 1) / 16)));
for (i = 0; i < NB; i++) {
    BS_[i] = Sprite(BARS[0]);
    BL[i] = 0;
    BS_[i].SetPosition(WX0 + Math.Int(i * BW_), SPY1 - BARS[0].GetHeight(), 4);
}
fun bar(i, lev) {
    if (lev < 0) lev = 0;
    if (lev > 15) lev = 15;
    lev = Math.Int(lev);
    if (lev == BL[i]) return;
    BL[i] = lev;
    BS_[i].SetImage(BARS[lev]);
    BS_[i].SetPosition(WX0 + Math.Int(i * BW_), SPY1 - BARS[lev].GetHeight(), 4);
}
PK.n = 0;                     # peaks for the spectrum this row: x, level

# ---- the stations ---------------------------------------------------------------------
T = 0;                        # seconds
ROWN = 0;                     # rows written
HEAD = 0;
QUIET = 0;                    # power-off: how far the stations have gone quiet
JAM = 0;                      # rows of jamming left
# Morse VVV: 1 on, 0 off, one entry per unit (a unit is 3 rows)
MORSE = "1010101110001010101110001010101110000000";
# LoRa packets: a queue of chirps; dir 1 up, -1 down; shift 0..1 (data)
LQ.n = 0;
LQI = 0;
LROW = 0;                     # row within the current chirp
fun lora_packet(dir, nd) {
    local.k = 0;
    for (k = 0; k < 8; k++) { LQ[LQ.n].dir = dir; LQ[LQ.n].sh = 0; LQ.n++; }
    for (k = 0; k < nd; k++) { LQ[LQ.n].dir = dir; LQ[LQ.n].sh = rnd(); LQ.n++; }
}
WX_NEXT = 3;                  # weather station: next burst (s)
BG_LORA = 9;                  # some other LoRa device: next packet (s)

ROWSP.n = 0;                  # sprites of each waterfall row

fun seg(r, img, x, w) {
    local.n = ROWSP[r].n;
    ROWSP[r].sp[n] = Sprite(img);
    ROWSP[r].sp[n].SetPosition(x - w / 2, WY0 + r * RH, 5);
    ROWSP[r].n = n + 1;
}

fun peak(x, lev) {
    PKX[PK.n] = x;
    PKL[PK.n] = lev;
    PK.n++;
}

fun write_row() {
    local.r = HEAD;
    local.x = 0;
    local.u = 0;
    local.c = NULL;
    local.k = 0;
    local.on = 1;
    ROWSP[r] = NULL;
    ROWSP[r].n = 0;
    PK.n = 0;
    if (JAM > 0) {
        seg(r, HOTN[Math.Int(rnd() * HOT_N)], WX0 + WW / 2, WW);
        global.JAM--;
    } else {
        seg(r, NOISE[Math.Int(rnd() * NOISE_N)], WX0 + WW / 2, WW);
    }
    # beacon carrier
    if (QUIET < 1) { x = fx(433.40); seg(r, CARRIER, x, CW * 3); peak(x, 13); }
    # drifting transmitter, on most of the time
    if (QUIET < 2 && (T % 23) < 17) {
        x = fx(434.20 + 0.035 * Math.Sin(T / 6));
        seg(r, CARRIER_W, x, CW * 3);
        peak(x, 9);
    }
    # Morse beacon
    if (QUIET < 3) {
        u = Math.Int(ROWN / 3) % MORSE.Length();
        if (MORSE.CharAt(u) == "1") { x = fx(433.65); seg(r, CARRIER, x, CW * 3); peak(x, 12); }
    }
    # weather station: two-tone FSK burst
    if (T >= WX_NEXT && QUIET < 2) {
        if (T < WX_NEXT + 1.3) {
            if (rnd() < 0.5) x = fx(434.43); else x = fx(434.47);
            seg(r, FSK, x, CW * 2);
            peak(x, 11);
        } else {
            global.WX_NEXT = T + 5 + rnd() * 6;
        }
    }
    # another LoRa device on a different channel
    if (T >= BG_LORA && QUIET < 2) {
        global.BG_LORA = T + 14 + rnd() * 10;
        global.BG_ROWS = SYM * 6;
        global.BG_X = fx(434.62 - 0.0625);
    }
    if (BG_ROWS > 0) {
        u = ((SYM * 6 - BG_ROWS) % SYM) / SYM;
        x = BG_X + u * LORA_BW / 2;
        seg(r, CHIRP, x, CHW);
        peak(x, 8);
        global.BG_ROWS--;
    }
    # our LoRa channel
    if (LQI < LQ.n) {
        c = LQ[LQI];
        u = LROW / SYM + c.sh;
        u = u - Math.Int(u);
        if (c.dir < 0) u = 1 - u;
        x = LX0 + u * (LORA_BW - CHW) + CHW / 2;
        seg(r, CHIRP, x, CHW);
        peak(x, 14);
        global.LROW++;
        if (LROW >= SYM) {
            global.LROW = 0;
            global.LQI++;
            if (LQI >= LQ.n) { global.LQ = NULL; global.LQ.n = 0; global.LQI = 0; }
        }
    }
    global.HEAD = (HEAD + 1) % NROWS;
    global.ROWN++;
    WLINE.SetPosition(WX0, WY0 + HEAD * RH, 7);
    fade();
}

# older rows dim: a few opacity levels by age
L = 5;
for (k = 1; k < L; k++) {
    AGE[k] = Math.Int(k * NROWS / L);
    f = 1 - k / L;
    OPL[k] = 0.25 + 0.75 * f;
}
fun fade() {
    local.k = 0;
    local.r = 0;
    local.j = 0;
    for (k = 1; k < L; k++) {
        r = (HEAD - 1 - AGE[k] + 2 * NROWS) % NROWS;
        for (j = 0; j < ROWSP[r].n; j++) ROWSP[r].sp[j].SetOpacity(OPL[k]);
    }
    # the row the head is about to overwrite is cleared, so the sweep shows
    ROWSP[HEAD] = NULL;
    ROWSP[HEAD].n = 0;
}

WLINE = Sprite(Image("tick.png").Scale(WW, 1));
WLINE.SetOpacity(0.6);

fun spectrum() {
    local.i = 0;
    local.k = 0;
    local.lev = 0;
    local.d = 0;
    local.base = 2;
    if (JAM > 0) base = 9;
    if (QUIET >= 3) base = 1;
    for (i = 0; i < NB; i++) LEV[i] = base + rnd() * 2.2;
    for (k = 0; k < PK.n; k++) {
        i = Math.Int((PKX[k] - WX0) / BW_);
        for (d = -2; d <= 2; d++) {
            if (i + d >= 0 && i + d < NB) {
                lev = PKL[k] - Math.Abs(d) * 4 + rnd();
                if (lev > LEV[i + d]) LEV[i + d] = lev;
            }
        }
    }
    for (i = 0; i < NB; i++) bar(i, LEV[i]);
}
LEV[0] = 0;
PKX[0] = 0;
PKL[0] = 0;

# ---- readout -------------------------------------------------------------------------------
SHOWN = "";
fun readout() {
    local.s = "sdr · 433.050 - 434.790 MHz · rbw 1 kHz · rows " + ROWN;
    if (QUIET >= 4) s = "sdr · receiver off";
    if (s == SHOWN) return;
    global.SHOWN = s;
    global.READ_R = txt_run("lo", s, SX + MARGIN, SY + Math.Int(FLH * 0.8), 50);
}

# ---- passphrase hooks ------------------------------------------------------------------------
fun hook_prompt() { }
fun hook_key(n) {
    # one packet per keystroke; while one is on the air, the next one waits in line
    if (LQ.n - LQI < 40) lora_packet(1, 3);
}
fun hook_erase(n) { if (LQ.n - LQI < 40) lora_packet(1, 1); }
fun hook_wrong() {
    global.JAM = 55;
    global.LQ = NULL;
    global.LQ.n = 0;
    global.LQI = 0;
    global.LROW = 0;
}
fun hook_enter() {
    # the gateway answers: down-chirps
    global.LQ = NULL;
    global.LQ.n = 0;
    global.LQI = 0;
    global.LROW = 0;
    lora_packet(-1, 6);
}
fun hook_question() { }

if (HALT) {
    if (MODE == "reboot") NIGHT_R = pr_line("lo", "see you soon.", PR.y1);
    else NIGHT_R = pr_line("lo", "good night.", PR.y1);
}

# ---- main loop ------------------------------------------------------------------------------
FRAME = 0;
BG_ROWS = 0;
BG_X = 0;
fun refresh() {
    global.FRAME++;
    global.T = T + 0.02;
    if (HALT) global.QUIET = Math.Int(T / 1.2);
    if (FRAME % 2 == 0 && QUIET < 5) write_row();
    if (FRAME % 3 == 0) spectrum();
    if (FRAME % 10 == 0) readout();
    prompt_tick();
}

# the radio has been running for a while: fill the waterfall with history
T = 0 - NROWS * 0.04;
WX_NEXT = T + 2;
BG_LORA = T + 5;
for (i = 0; i < NROWS; i++) {
    write_row();
    T = T + 0.04;
}
T = 0;
WX_NEXT = 3;
BG_LORA = 9;
readout();
prompt_setup();
Plymouth.SetRefreshFunction(refresh);
