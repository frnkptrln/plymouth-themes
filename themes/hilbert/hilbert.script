# Turn a string into an array of CP437 codes (out.n = length). out.off[k] is
# the byte offset where glyph k starts, out.off[out.n] the length in bytes:
# Plymouth's string functions count bytes, and "•" alone is three of them.
fun txt_codes(s) {
    local.out.n = 0;
    local.i = 0;
    local.k = 0;
    local.c = s.CharAt(0);
    while (c != "") {
        out.off[out.n] = i;
        k = TXT.ord[c];
        if (k) { out[out.n] = k; out.n++; i++; }
        else {
            k = TXT.u8[s.SubString(i, i + 3)];
            if (k) { out[out.n] = k; out.n++; i += 3; }
            else {
                k = TXT.u8[s.SubString(i, i + 2)];
                if (k) { out[out.n] = k; out.n++; i += 2; }
                else { out[out.n] = 63; out.n++; i++; }
            }
        }
        c = s.CharAt(i);
    }
    out.off[out.n] = i;
    return out;
}

# Number of glyphs a string renders to.
fun txt_len(s) {
    local.c = txt_codes(s);
    return c.n;
}

# Load a font atlas. fid: short id, file: atlas PNG, cw/ch: atlas cell size,
# adv: horizontal advance, lh: line height, pad: glow margin around each glyph.
FONT.count = 0;     # must exist at top level so functions see the globals
GLYPH.count = 0;

fun font_load(fid, file, cw, ch, adv, lh, pad) {
    global.FONT[fid].atlas = Image(file);
    global.FONT[fid].cw = cw;
    global.FONT[fid].ch = ch;
    global.FONT[fid].adv = adv;
    global.FONT[fid].lh = lh;
    global.FONT[fid].pad = pad;
}

fun glyph(fid, code) {
    if (!GLYPH[fid][code])
        global.GLYPH[fid][code] = FONT[fid].atlas.Crop((code % 16) * FONT[fid].cw,
                                                Math.Int(code / 16) * FONT[fid].ch,
                                                FONT[fid].cw, FONT[fid].ch);
    return GLYPH[fid][code];
}

# Create sprites for a string at (x, y). Returns a run object; drop it to erase.
fun txt_run(fid, s, x, y, z) {
    local.codes = txt_codes(s);
    local.r.n = codes.n;
    local.r.w = codes.n * FONT[fid].adv;
    local.r.x = x;
    local.r.y = y;
    local.i = 0;
    for (i = 0; i < codes.n; i++) {
        if (codes[i] != 32) {
            r.sp[i] = Sprite(glyph(fid, codes[i]));
            r.sp[i].SetPosition(x + i * FONT[fid].adv - FONT[fid].pad, y - FONT[fid].pad, z);
        }
    }
    return r;
}

# Same, from an already decoded code array (from index a, count n).
fun txt_run_codes(fid, codes, a, n, x, y, z) {
    local.r.n = n;
    local.r.w = n * FONT[fid].adv;
    local.r.x = x;
    local.r.y = y;
    local.i = 0;
    for (i = 0; i < n; i++) {
        if (codes[a + i] != 32) {
            r.sp[i] = Sprite(glyph(fid, codes[a + i]));
            r.sp[i].SetPosition(x + i * FONT[fid].adv - FONT[fid].pad, y - FONT[fid].pad, z);
        }
    }
    return r;
}

fun run_opacity(r, o) {
    local.i = 0;
    for (i = 0; i < r.n; i++) if (r.sp[i]) r.sp[i].SetOpacity(o);
}

fun run_move(r, x, y) {
    local.i = 0;
    local.fid = 0;
    for (i = 0; i < r.n; i++)
        if (r.sp[i]) r.sp[i].SetPosition(x + (r.sp[i].GetX() - r.x), y + (r.sp[i].GetY() - r.y), r.sp[i].GetZ());
    r.x = x;
    r.y = y;
}

# Shorten s to at most n glyphs by cutting out the middle, at glyph
# boundaries, so a multi-byte character is never split.
fun txt_fit(s, n) {
    local.c = txt_codes(s);
    local.h = 0;
    if (c.n <= n) return s;
    if (n < 5) return s.SubString(0, c.off[n]);
    h = Math.Int((n - 3) / 2);
    return s.SubString(0, c.off[h]) + "..." + s.SubString(c.off[c.n - (n - 3 - h)], c.off[c.n]);
}

# Uniform random number in [0, 1). Plymouth 24's Math.Random() returns values
# scaled down by 2^32; normalise so this also works if that ever gets fixed.
fun rnd() {
    local.r = Math.Random();
    if (r < 0.000001) r = r * 4294967296;
    return r - Math.Int(r);
}

# Pick the largest integer scale (from 1..maxs) at which a cols x rows grid of
# (cw x lh) cells still fits into w x h.
fun pick_scale(w, h, cw, lh, cols, rows, maxs) {
    local.s = maxs;
    while (s > 1 && (cols * cw * s > w || rows * lh * s > h)) s--;
    return s;
}


#==============================================================================
# passphrase, question and message handling, shared by the newer themes
#
# Before prompt_setup() the theme sets
#   PR.hi, PR.lo, PR.err   font ids: entry, prompt and messages, warnings
#   PR.y0 .. PR.y3         top of the lines: warning, prompt, entry, caps lock
#   PR.cx                  centre x of the text (PR.align = "center"), or
#   PR.left                left edge (PR.align = "left")
#   PR.maxc                most glyphs on a line
#   PR.adv                 glyph advance in px
#   PR.z                   z of the text
# and defines all of these hooks (empty bodies are fine):
#   hook_prompt()          a passphrase prompt appeared
#   hook_wrong()           the same prompt came back: the passphrase was wrong
#   hook_key(n)            a character was typed, n characters now
#   hook_erase(n)          a character was deleted
#   hook_enter()           Enter: the passphrase went to the disk
#   hook_question()        a question appeared
# Its refresh function calls prompt_tick() once per frame.
#==============================================================================
PR.wrong = "wrong. try again.";
PR.caps_text = "caps lock";
PR.align = "center";
PR.z = 50;
P.active = 0;          # 0 none, 1 passphrase, 2 question
P.bullets = -1;
P.prompt = "";
P.last = "";
P.answered = 0;
P.err = 0;
P.blink = 0;
P.caps = 0;
P.msg = 0;

fun nearest(list, v) {
    local.best = 999999;
    local.r = list[0];
    local.i = 0;
    for (i = 0; i < list.n; i++)
        if (Math.Abs(list[i] - v) < best) { best = Math.Abs(list[i] - v); r = list[i]; }
    return r;
}

# Pick the LM Mono size for this screen and load the given font ids.
fun lm_load(ids, target) {
    local.i = 0;
    global.FS = nearest(FSL, target);
    for (i = 0; i < FSL.n; i++) if (FSL[i] == FS) { global.FADV = FSA[i]; global.FLH = FSH[i]; }
    for (i = 0; i < ids.n; i++)
        font_load(ids[i], "font-" + ids[i] + "-" + FS + ".png", FADV, FLH, FADV, FLH, 0);
}

# The four text lines at the bottom of the screen, centred.
fun prompt_bottom(cx, maxw) {
    PR.cx = cx;
    PR.adv = FADV;
    PR.maxc = Math.Int(maxw / FADV);
    PR.y3 = SY + SH - Math.Int(FLH * 1.3);
    PR.y2 = PR.y3 - FLH;
    PR.y1 = PR.y2 - Math.Int(FLH * 1.05);
    PR.y0 = PR.y1 - Math.Int(FLH * 1.05);
}

fun pr_x(n) {
    if (PR.align == "left") return PR.left;
    return PR.cx - Math.Int(n * PR.adv / 2);
}

fun pr_line(fid, s, y) {
    local.t = txt_fit(s, PR.maxc);
    return txt_run(fid, t, pr_x(txt_len(t)), y, PR.z);
}

fun pr_entry(s) {
    local.t = txt_fit(s, PR.maxc - 2);
    local.x = pr_x(txt_len(t) + 1);
    global.PR_ENTRY = txt_run(PR.hi, t, x, PR.y2, PR.z);
    global.PR_CURSOR = txt_run(PR.hi, "_", x + txt_len(t) * PR.adv, PR.y2, PR.z);
}

fun on_password(prompt, bullets) {
    local.s = "";
    local.i = 0;
    local.n = 0;
    if (P.active != 1) {
        global.PR_MSG = NULL;
        P.msg = 0;
        if (P.answered && prompt == P.last) {
            P.err = 220;
            global.PR_ERR = NULL;
            hook_wrong();
        } else {
            hook_prompt();
        }
        P.active = 1;
        P.prompt = prompt;
        P.bullets = -1;
        if (prompt == "") prompt = "passphrase:";
        global.PR_PROMPT = pr_line(PR.lo, prompt, PR.y1);
    }
    if (bullets != P.bullets) {
        if (P.bullets >= 0) {
            if (bullets > P.bullets) hook_key(bullets);
            else hook_erase(bullets);
        }
        P.bullets = bullets;
        n = bullets;
        if (n > 40) n = 40;
        for (i = 0; i < n; i++) s = s + "• ";
        pr_entry(s);
    }
}

fun on_question(prompt, entry) {
    if (P.active != 2) {
        P.active = 2;
        P.err = 0;
        global.PR_ERR = NULL;
        global.PR_MSG = NULL;
        global.PR_PROMPT = pr_line(PR.lo, prompt, PR.y1);
        hook_question();
    }
    pr_entry(entry);
}

fun on_normal() {
    if (P.active == 1) {
        P.answered = 1;
        P.last = P.prompt;
        hook_enter();
    }
    P.active = 0;
    P.bullets = -1;
    global.PR_PROMPT = NULL;
    global.PR_ENTRY = NULL;
    global.PR_CURSOR = NULL;
    global.PR_CAPS = NULL;
    P.caps = 0;
}

fun on_message(text) {
    if (P.active) return;
    global.PR_MSG = pr_line(PR.lo, text, PR.y1);
    P.msg = 250;
}

fun on_hide_message(text) {
    global.PR_MSG = NULL;
    P.msg = 0;
}

fun prompt_tick() {
    if (P.active) {
        P.blink = (P.blink + 1) % 50;
        if (PR_CURSOR) run_opacity(PR_CURSOR, P.blink < 25);
        if (P.active == 1 && P.blink % 10 == 0) {
            if (Plymouth.GetCapslockState()) {
                if (!P.caps) global.PR_CAPS = pr_line(PR.err, PR.caps_text, PR.y3);
                P.caps = 1;
            } else {
                P.caps = 0;
                global.PR_CAPS = NULL;
            }
        }
    }
    if (P.err > 0) {
        if (!PR_ERR) global.PR_ERR = pr_line(PR.err, PR.wrong, PR.y0);
        P.err--;
        if (P.err < 30) run_opacity(PR_ERR, P.err / 30);
        if (P.err == 0) global.PR_ERR = NULL;
    }
    if (P.msg > 0) {
        P.msg--;
        if (P.msg == 0) global.PR_MSG = NULL;
    }
}

fun prompt_setup() {
    Plymouth.SetDisplayPasswordFunction(on_password);
    Plymouth.SetDisplayQuestionFunction(on_question);
    Plymouth.SetDisplayNormalFunction(on_normal);
    Plymouth.SetDisplayMessageFunction(on_message);
    Plymouth.SetHideMessageFunction(on_hide_message);
}

FSL[0] = 14; FSA[0] = 7; FSH[0] = 23;
FSL[1] = 17; FSA[1] = 9; FSH[1] = 28;
FSL[2] = 20; FSA[2] = 10; FSH[2] = 32;
FSL[3] = 24; FSA[3] = 13; FSH[3] = 38;
FSL[4] = 28; FSA[4] = 15; FSH[4] = 44;
FSL[5] = 34; FSA[5] = 18; FSH[5] = 53;
FSL[6] = 40; FSA[6] = 21; FSH[6] = 62;
FSL.n = 7;

MODE = Plymouth.GetMode();
HALT = (MODE == "shutdown" || MODE == "reboot");

# ---- text ---------------------------------------------------------------------
IDS[0] = "hi"; IDS[1] = "lo"; IDS[2] = "err"; IDS.n = 3;
lm_load(IDS, SH / 52);
prompt_bottom(SX + SW / 2, SW * 0.9);
PR.hi = "hi"; PR.lo = "lo"; PR.err = "err";

# ---- the sheet ----------------------------------------------------------------
NC = 64;                     # cells per side
NSEG = NC * NC - 1;
TOP = SY + Math.Int(SH * 0.06);
AVAIL = PR.y0 - Math.Int(FLH * 2.6) - TOP;
if (AVAIL > SW * 0.86) AVAIL = Math.Int(SW * 0.86);
C = Math.Int(AVAIL / (NC + 3));      # cell size in px, integer so the joints meet
if (C < 3) C = 3;
MG = Math.Int(C * 1.5);              # margin of the drawing on the sheet
PS = NC * C + 2 * MG;
PX = SX + Math.Int((SW - PS) / 2);
PY = TOP + Math.Int((AVAIL - PS) / 2);
LW = Math.Int(C / 5);                # line width
if (LW < 2) LW = 2;

SOLID = Image("solid.png");
SHADOW = Sprite(Image("shadow.png").Scale(PS, PS));
SHADOW.SetPosition(PX + Math.Int(C / 2), PY + Math.Int(C / 2), 1);
SHEET = Sprite(Image("paper.png").Scale(PS, PS));
SHEET.SetPosition(PX, PY, 2);

# crop marks just outside the corners of the drawing area (the L in mark.png
# has its corner at the image centre and points right and down)
MARK = Image("mark.png").Scale(2 * C, 2 * C);
MK.n = 4;                            # global, so mark() stores the sprites here
fun mark(i, x, y) {
    MK[i] = Sprite(MARK.Rotate(i * 1.5707963));
    MK[i].SetPosition(x - C, y - C, 3);
}
MX0 = PX + MG - Math.Int(C / 2);
MX1 = PX + PS - MG + Math.Int(C / 2);
MY0 = PY + MG - Math.Int(C / 2);
MY1 = PY + PS - MG + Math.Int(C / 2);
mark(0, MX1, MY1);
mark(1, MX0, MY1);
mark(2, MX0, MY0);
mark(3, MX1, MY0);

# segment images: horizontal and vertical, ink and red
INKH = Image("ink.png").Scale(C + LW, LW);
INKV = Image("ink.png").Scale(LW, C + LW);
REDH = Image("red.png").Scale(C + LW, LW);
REDV = Image("red.png").Scale(LW, C + LW);

# ---- the curve: start at the lower left, one move per character ------------------
MOVES = "";
GX[0] = 0;
GY[0] = NC - 1;
for (i = 0; i < NSEG; i++) {
    m = MOVES.CharAt(i);
    GX[i + 1] = GX[i];
    GY[i + 1] = GY[i];
    if (m == "r") GX[i + 1] = GX[i] + 1;
    else if (m == "l") GX[i + 1] = GX[i] - 1;
    else if (m == "u") GY[i + 1] = GY[i] - 1;
    else GY[i + 1] = GY[i] + 1;
}

fun px(i) { return PX + MG + GX[i] * C + Math.Int(C / 2); }
fun py(i) { return PY + MG + GY[i] * C + Math.Int(C / 2); }

# ---- the plotter ---------------------------------------------------------------
ARM = Sprite(Image("arm.png").Scale(PS + 6 * C, Math.Max(4, Math.Int(C * 0.55))));
ARMH = Math.Int(Math.Max(4, Math.Int(C * 0.55)) / 2);
CAR_IMG = Image("carriage.png").Scale(Math.Int(C * 1.7), Math.Int(C * 2.3));
CAR = Sprite(CAR_IMG);
CARW = CAR_IMG.GetWidth() / 2;
CARH = CAR_IMG.GetHeight() / 2;
TIP_IMG = Image("tip.png").Scale(LW * 3, LW * 3);
TIP = Sprite(TIP_IMG);
TIPH = TIP_IMG.GetWidth() / 2;

NS = 0;                       # segments on the paper
NRED = 0;                     # how many of them are red (the passphrase)
RED0 = 0;                     # first red segment
WIPE = 0;                     # segments still to wipe back
TARGET = 0;                   # where the pen is headed
PENDOWN = 1;
FRAME = 0;
T = 0;
PROGRESS = 0;
PACE = 220;                   # segments per second: the whole curve in under 19 s
SEGS[0] = 0;                  # sprites of the segments (global)

fun put_seg(i, red) {
    local.x0 = px(i);
    local.y0 = py(i);
    local.x1 = px(i + 1);
    local.y1 = py(i + 1);
    local.h = (y0 == y1);
    local.img = 0;
    if (h) { if (red) img = REDH; else img = INKH; }
    else { if (red) img = REDV; else img = INKV; }
    SEGS[i] = Sprite(img);
    SEGS[i].SetPosition(Math.Min(x0, x1) - Math.Int(LW / 2), Math.Min(y0, y1) - Math.Int(LW / 2), 5);
}

fun recolor(i) {
    if (py(i) == py(i + 1)) SEGS[i].SetImage(INKH);
    else SEGS[i].SetImage(INKV);
}

fun place_pen(i) {
    local.x = px(i);
    local.y = py(i);
    ARM.SetPosition(PX - 3 * C, y - ARMH, 7);
    CAR.SetPosition(x - CARW, y - CARH, 8);
    TIP.SetPosition(x - TIPH, y - TIPH, 9);
    if (PENDOWN) TIP.SetOpacity(1); else TIP.SetOpacity(0.25);
}

# ---- readout --------------------------------------------------------------------
RY = PY + PS + Math.Int(FLH * 0.7);
SHOWN = "";
fun readout() {
    local.ux = 400 + GX[NS] * 160;
    local.uy = 400 + (NC - 1 - GY[NS]) * 160;
    local.cmd = "PD";
    local.s = "";
    if (!PENDOWN) cmd = "PU";
    s = "HP-GL  " + cmd + " " + ux + "," + uy + ";";
    if (s == SHOWN) return;
    global.SHOWN = s;
    global.READ_L = txt_run("lo", s, PX, RY, 50);
    s = "" + NS + "/" + NSEG;
    global.READ_R = txt_run("lo", s, PX + PS - txt_len(s) * FADV, RY, 50);
}

# ---- progress -------------------------------------------------------------------
fun on_progress(duration, progress) {
    global.PROGRESS = progress;
}

fun advance() {
    local.k = 0;
    local.t = 0;
    if (WIPE > 0) {
        # the wrong passphrase is wiped back, three segments a frame
        for (k = 0; k < 3 && WIPE > 0; k++) {
            global.NS--;
            SEGS[NS] = NULL;
            global.WIPE--;
            global.NRED--;
        }
        global.TARGET = NS;
        place_pen(NS);
        return;
    }
    if (P.active == 1) {
        # waiting for the passphrase: the pen only moves when you type
        t = RED0 + NRED;
    } else {
        # the boot: whichever is further, a steady pace or plymouth's estimate
        t = Math.Int(T * PACE);
        if (PROGRESS * NSEG > t) t = Math.Int(PROGRESS * NSEG);
        if (t < TARGET) t = TARGET;
    }
    if (t > NSEG) t = NSEG;
    global.TARGET = t;
    global.PENDOWN = (NS < TARGET || P.active != 1);
    for (k = 0; k < 7 && NS < TARGET; k++) {
        put_seg(NS, (P.active == 1));
        global.NS++;
    }
    place_pen(NS);
}

# ---- passphrase hooks -------------------------------------------------------------
PER_CHAR = 12;
fun hook_prompt() {
    global.RED0 = NS;
    global.NRED = 0;
}
fun hook_key(n) {
    global.NRED = n * PER_CHAR;
    if (RED0 + NRED > NSEG) global.NRED = NSEG - RED0;
}
fun hook_erase(n) {
    # deleting a character wipes its segments
    local.want = RED0 + n * PER_CHAR;
    if (want < NS) {
        global.WIPE = NS - want;
        global.NRED = NS - RED0;
    } else {
        global.NRED = n * PER_CHAR;
    }
}
fun hook_wrong() {
    # the previous attempt is wiped off the paper, back to where it began
    global.WIPE = NS - RED0;
    global.NRED = NS - RED0;
}
fun hook_enter() {
    local.i = 0;
    # the ink dries: red turns black, the pen goes on with the boot
    for (i = RED0; i < NS; i++) recolor(i);
    global.TARGET = NS;
    global.NRED = 0;
    global.T = NS / PACE;
}
fun hook_question() { }

# ---- power-off: the curve is retraced and lifted off ---------------------------------
fun undraw() {
    local.k = 0;
    for (k = 0; k < 10 && NS > 0; k++) {
        global.NS--;
        SEGS[NS] = NULL;
    }
    place_pen(NS);
}

if (HALT) {
    for (i = 0; i < NSEG; i++) put_seg(i, 0);
    NS = NSEG;
    TARGET = NSEG;
    if (MODE == "reboot") NIGHT_R = pr_line("lo", "see you soon.", PR.y1);
    else NIGHT_R = pr_line("lo", "good night.", PR.y1);
}
place_pen(NS);

# ---- main loop ------------------------------------------------------------------
fun refresh() {
    global.FRAME++;
    global.T = T + 0.02;
    if (HALT) { if (FRAME > 40) undraw(); }
    else advance();
    if (FRAME % 6 == 0) readout();
    prompt_tick();
}

prompt_setup();
Plymouth.SetBootProgressFunction(on_progress);
Plymouth.SetRefreshFunction(refresh);
