# Turn a string into an array of CP437 codes (out.n = length). out.off[k] is
# the byte offset where glyph k starts, out.off[out.n] the length in bytes:
# Plymouth's string functions count bytes, and "•" alone is three of them.
fun txt_codes(s) {
    local.out.n = 0;
    local.i = 0;
    local.k = 0;
    local.c = s.CharAt(0);
    while (c != "") {
        out.off[out.n] = i;
        k = TXT.ord[c];
        if (k) { out[out.n] = k; out.n++; i++; }
        else {
            k = TXT.u8[s.SubString(i, i + 3)];
            if (k) { out[out.n] = k; out.n++; i += 3; }
            else {
                k = TXT.u8[s.SubString(i, i + 2)];
                if (k) { out[out.n] = k; out.n++; i += 2; }
                else { out[out.n] = 63; out.n++; i++; }
            }
        }
        c = s.CharAt(i);
    }
    out.off[out.n] = i;
    return out;
}

# Number of glyphs a string renders to.
fun txt_len(s) {
    local.c = txt_codes(s);
    return c.n;
}

# Load a font atlas. fid: short id, file: atlas PNG, cw/ch: atlas cell size,
# adv: horizontal advance, lh: line height, pad: glow margin around each glyph.
FONT.count = 0;     # must exist at top level so functions see the globals
GLYPH.count = 0;

fun font_load(fid, file, cw, ch, adv, lh, pad) {
    global.FONT[fid].atlas = Image(file);
    global.FONT[fid].cw = cw;
    global.FONT[fid].ch = ch;
    global.FONT[fid].adv = adv;
    global.FONT[fid].lh = lh;
    global.FONT[fid].pad = pad;
}

fun glyph(fid, code) {
    if (!GLYPH[fid][code])
        global.GLYPH[fid][code] = FONT[fid].atlas.Crop((code % 16) * FONT[fid].cw,
                                                Math.Int(code / 16) * FONT[fid].ch,
                                                FONT[fid].cw, FONT[fid].ch);
    return GLYPH[fid][code];
}

# Create sprites for a string at (x, y). Returns a run object; drop it to erase.
fun txt_run(fid, s, x, y, z) {
    local.codes = txt_codes(s);
    local.r.n = codes.n;
    local.r.w = codes.n * FONT[fid].adv;
    local.r.x = x;
    local.r.y = y;
    local.i = 0;
    for (i = 0; i < codes.n; i++) {
        if (codes[i] != 32) {
            r.sp[i] = Sprite(glyph(fid, codes[i]));
            r.sp[i].SetPosition(x + i * FONT[fid].adv - FONT[fid].pad, y - FONT[fid].pad, z);
        }
    }
    return r;
}

# Same, from an already decoded code array (from index a, count n).
fun txt_run_codes(fid, codes, a, n, x, y, z) {
    local.r.n = n;
    local.r.w = n * FONT[fid].adv;
    local.r.x = x;
    local.r.y = y;
    local.i = 0;
    for (i = 0; i < n; i++) {
        if (codes[a + i] != 32) {
            r.sp[i] = Sprite(glyph(fid, codes[a + i]));
            r.sp[i].SetPosition(x + i * FONT[fid].adv - FONT[fid].pad, y - FONT[fid].pad, z);
        }
    }
    return r;
}

fun run_opacity(r, o) {
    local.i = 0;
    for (i = 0; i < r.n; i++) if (r.sp[i]) r.sp[i].SetOpacity(o);
}

fun run_move(r, x, y) {
    local.i = 0;
    local.fid = 0;
    for (i = 0; i < r.n; i++)
        if (r.sp[i]) r.sp[i].SetPosition(x + (r.sp[i].GetX() - r.x), y + (r.sp[i].GetY() - r.y), r.sp[i].GetZ());
    r.x = x;
    r.y = y;
}

# Shorten s to at most n glyphs by cutting out the middle, at glyph
# boundaries, so a multi-byte character is never split.
fun txt_fit(s, n) {
    local.c = txt_codes(s);
    local.h = 0;
    if (c.n <= n) return s;
    if (n < 5) return s.SubString(0, c.off[n]);
    h = Math.Int((n - 3) / 2);
    return s.SubString(0, c.off[h]) + "..." + s.SubString(c.off[c.n - (n - 3 - h)], c.off[c.n]);
}

# Uniform random number in [0, 1). Plymouth 24's Math.Random() returns values
# scaled down by 2^32; normalise so this also works if that ever gets fixed.
fun rnd() {
    local.r = Math.Random();
    if (r < 0.000001) r = r * 4294967296;
    return r - Math.Int(r);
}

# Pick the largest integer scale (from 1..maxs) at which a cols x rows grid of
# (cw x lh) cells still fits into w x h.
fun pick_scale(w, h, cw, lh, cols, rows, maxs) {
    local.s = maxs;
    while (s > 1 && (cols * cw * s > w || rows * lh * s > h)) s--;
    return s;
}


# ---- seeded PRNG (Park-Miller, exact in doubles) -----------------------------
SEED = Math.Int(rnd() * 65536);
PS = SEED + 1;
fun prng() {
    global.PS = (PS * 16807) % 2147483647;
    return PS / 2147483647;
}
HEX = "0123456789abcdef";
fun hex4(n) {
    local.s = "";
    local.i = 0;
    for (i = 0; i < 4; i++) {
        s = HEX.CharAt(n % 16) + s;
        n = Math.Int(n / 16);
    }
    return s;
}
fun pad5(n) {
    local.s = "" + n;
    while (s.Length() < 5) s = "0" + s;
    return s;
}

# ---- geometry ---------------------------------------------------------------
CSL[0] = 8; CSG[0] = 0;
CSL[1] = 12; CSG[1] = 0;
CSL[2] = 16; CSG[2] = 0;
CSL[3] = 20; CSG[3] = 0;
CSL[4] = 24; CSG[4] = 0;
CSL[5] = 32; CSG[5] = 0;
CSL.n = 6;
FSL[0] = 14; FSA[0] = 7; FSH[0] = 23;
FSL[1] = 17; FSA[1] = 9; FSH[1] = 28;
FSL[2] = 20; FSA[2] = 10; FSH[2] = 32;
FSL[3] = 24; FSA[3] = 13; FSH[3] = 38;
FSL[4] = 28; FSA[4] = 15; FSH[4] = 44;
FSL[5] = 34; FSA[5] = 18; FSH[5] = 53;
FSL[6] = 40; FSA[6] = 21; FSH[6] = 62;
FSL.n = 7;
CS = CSL[0];
best = 99999;
for (i = 0; i < CSL.n; i++) {
    d = Math.Abs(CSL[i] - SH / 68);
    if (d < best) { best = d; CS = CSL[i]; G = CSG[i]; }
}
FS = FSL[0];
best = 99999;
for (i = 0; i < FSL.n; i++) {
    d = Math.Abs(FSL[i] - SH / 50);
    if (d < best) { best = d; FS = FSL[i]; FADV = FSA[i]; FLH = FSH[i]; }
}
font_load("hi",  "font-hi-"  + FS + ".png", FADV, FLH, FADV, FLH, 0);
font_load("lo",  "font-lo-"  + FS + ".png", FADV, FLH, FADV, FLH, 0);
font_load("err", "font-err-" + FS + ".png", FADV, FLH, FADV, FLH, 0);

CELLS = Image("cells-" + CS + ".png");
HOTS = Image("hot-" + CS + ".png");
CCW = 8 * CS + 2 * G;
CCH = CS + 2 * G;
NCH = Math.Int((SW + 8 * CS - 1) / (8 * CS));
NCOLS = NCH * 8;
FX = SX + Math.Int((SW - NCOLS * CS) / 2);
FOOT = Math.Int(FLH * 4.2);
NROWS = Math.Int((SH - FOOT) / CS);
FY = SY;
MARGIN = Math.Int(FADV * 2);
LY0 = SY + NROWS * CS + Math.Int(FLH * 0.8);   # footer line 1
LY1 = LY0 + FLH;                               # footer line 2
LY2 = LY1 + Math.Int(FLH * 1.15);              # footer line 3

fun chunk(idx) {
    if (!CHUNK[idx])
        global.CHUNK[idx] = CELLS.Crop((idx % 16) * CCW, Math.Int(idx / 16) * CCH, CCW, CCH);
    return CHUNK[idx];
}
fun hot(idx) {
    if (!HOTC[idx])
        global.HOTC[idx] = HOTS.Crop((idx % 16) * CCW, Math.Int(idx / 16) * CCH, CCW, CCH);
    return HOTC[idx];
}
CHUNK.n = 0;
HOTC.n = 0;
ROW.n = 0;

# ---- rule -------------------------------------------------------------------
RL[0] = 30; RI[0] = "s";
RL[1] = 110; RI[1] = "r";
RL[2] = 90; RI[2] = "s";
RL[3] = 150; RI[3] = "s";
RL[4] = 18; RI[4] = "s";
RL[5] = 126; RI[5] = "s";
RL[6] = 22; RI[6] = "s";
RL[7] = 54; RI[7] = "r";
RL[8] = 73; RI[8] = "r";
RL[9] = 137; RI[9] = "r";
RL[10] = 106; RI[10] = "r";
RL[11] = 30; RI[11] = "s";
RL[12] = 110; RI[12] = "r";
RL.n = 13;
MODE = Plymouth.GetMode();
TITLE = "";
if (MODE == "shutdown" || MODE == "reboot") {
    RULE = 128;          # erosion: every block shrinks to nothing
    INIT = "d";
    TITLE = "halt";
    if (MODE == "reboot") TITLE = "reboot";
} else {
    k = Math.Int(prng() * RL.n);
    RULE = RL[k];
    INIT = RI[k];
}
r = RULE;
for (n = 0; n < 8; n++) { RT[n] = r % 2; r = Math.Int(r / 2); }

for (i = 0; i < NCOLS; i++) {
    DENS = 0.5;
    if (INIT == "d") DENS = 0.965;
    if (INIT == "s") CUR[i] = 0;
    else if (prng() < DENS) CUR[i] = 1;
    else CUR[i] = 0;
}
if (INIT == "s") CUR[Math.Int(NCOLS / 2)] = 1;

fun ca_step() {
    local.i = 0;
    for (i = 0; i < NCOLS; i++)
        NXT[i] = RT[CUR[(i + NCOLS - 1) % NCOLS] * 4 + CUR[i] * 2 + CUR[(i + 1) % NCOLS]];
    for (i = 0; i < NCOLS; i++) global.CUR[i] = NXT[i];
}

# ---- phosphor decay: L opacity levels, only rows crossing a level change ----
L = 12;
for (k = 1; k < L; k++) {
    AGE[k] = Math.Int((k * NROWS + L - 1) / L);
    f = 1 - k / L;
    OPL[k] = 0.06 + 0.94 * f * f;
}

fun row_opacity(r, o) {
    local.j = 0;
    for (j = 0; j < NCH; j++) if (ROW[r][j]) ROW[r][j].SetOpacity(o);
}

fun draw_row(r) {
    local.j = 0;
    local.k = 0;
    local.idx = 0;
    for (j = 0; j < NCH; j++) {
        idx = 0;
        for (k = 0; k < 8; k++) idx = idx * 2 + CUR[j * 8 + k];
        if (idx == 0) {
            global.ROW[r][j] = NULL;
        } else {
            if (!ROW[r][j]) {
                global.ROW[r][j] = Sprite(hot(idx));
                ROW[r][j].SetPosition(FX + j * 8 * CS - G, FY + r * CS - G, 1);
            } else {
                ROW[r][j].SetImage(hot(idx));
            }
            ROW[r][j].SetOpacity(1);
        }
        global.RIDX[r][j] = idx;
    }
}

fun cool_row(r) {
    local.j = 0;
    for (j = 0; j < NCH; j++) if (ROW[r][j]) ROW[r][j].SetImage(chunk(RIDX[r][j]));
}
RIDX.n = 0;

HEAD = -1;
GEN = 0;
fun generation() {
    local.k = 0;
    if (GEN > 0) ca_step();
    if (HEAD >= 0) cool_row(HEAD);
    global.HEAD = (HEAD + 1) % NROWS;
    draw_row(HEAD);
    for (k = 1; k < L; k++)
        if (AGE[k] <= GEN) row_opacity((HEAD - AGE[k] + NROWS) % NROWS, OPL[k]);
    global.GEN++;
}

# ---- footer -----------------------------------------------------------------
LINE = Image("line.png").Scale(SW - 2 * MARGIN, 1);
LINE_S = Sprite(LINE);
LINE_S.SetPosition(SX + MARGIN, SY + NROWS * CS + Math.Int(FLH * 0.35), 3);
LINE_S.SetOpacity(0.35);

LABEL = "rule " + RULE + " · seed " + hex4(SEED);
if (TITLE != "") LABEL = TITLE + " · " + LABEL;
LABEL_R = txt_run("lo", LABEL, SX + MARGIN, LY0, 5);
GEN_SHOWN = -1;
fun draw_gen() {
    local.s = "gen " + pad5(GEN);
    global.GEN_R = txt_run("lo", s, SX + SW - MARGIN - txt_len(s) * FADV, LY0, 5);
}

# ---- password / question ----------------------------------------------------
P.active = 0;
P.bullets = -1;
P.prompt = "";
P.last = "";
P.answered = 0;
P.err = 0;
P.blink = 0;
P.caps = 0;
MSG.t = 0;

fun perturb_one() {
    local.i = Math.Int(prng() * NCOLS);
    global.CUR[i] = 1 - CUR[i];
}

fun perturb_band() {
    local.a = Math.Int(prng() * NCOLS);
    local.i = 0;
    for (i = 0; i < NCOLS / 3; i++)
        if (prng() < 0.5) global.CUR[(a + i) % NCOLS] = 1 - CUR[(a + i) % NCOLS];
}

fun draw_entry(s) {
    local.t = txt_fit(s, Math.Int((SW - 2 * MARGIN) / FADV) - 3);
    global.ENTRY_R = txt_run("hi", "> " + t, SX + MARGIN, LY2, 6);
    global.CURSOR_R = txt_run("hi", "_", SX + MARGIN + (txt_len(t) + 2) * FADV, LY2, 6);
}

fun on_password(prompt, bullets) {
    local.s = "";
    local.i = 0;
    local.n = 0;
    if (P.active != 1) {
        if (P.answered && prompt == P.last) {
            P.err = 220;
            perturb_band();
        }
        P.active = 1;
        P.prompt = prompt;
        P.bullets = -1;
        if (prompt == "") prompt = "passphrase:";
        global.PROMPT_R = txt_run("lo", txt_fit(prompt, Math.Int((SW - 2 * MARGIN) / FADV)), SX + MARGIN, LY1, 6);
        global.MSG_R = NULL;
    }
    if (bullets > P.bullets && P.bullets >= 0) for (i = P.bullets; i < bullets; i++) perturb_one();
    if (bullets != P.bullets) {
        P.bullets = bullets;
        n = bullets;
        if (n > 40) n = 40;
        for (i = 0; i < n; i++) s = s + "• ";
        draw_entry(s);
    }
}

fun on_question(prompt, entry) {
    if (P.active != 2) {
        P.active = 2;
        P.err = 0;
        global.ERR_R = NULL;
        global.PROMPT_R = txt_run("lo", txt_fit(prompt, Math.Int((SW - 2 * MARGIN) / FADV)), SX + MARGIN, LY1, 6);
    }
    draw_entry(entry);
    perturb_one();
}

fun on_normal() {
    if (P.active == 1) {
        P.answered = 1;
        P.last = P.prompt;
    }
    P.active = 0;
    P.bullets = -1;
    global.PROMPT_R = NULL;
    global.ENTRY_R = NULL;
    global.CURSOR_R = NULL;
    global.CAPS_R = NULL;
    P.caps = 0;
}

fun on_message(text) {
    if (P.active) return;
    global.MSG_R = txt_run("lo", txt_fit(text, Math.Int((SW - 2 * MARGIN) / FADV)), SX + MARGIN, LY1, 6);
    MSG.t = 250;
}

fun on_hide_message(text) {
    global.MSG_R = NULL;
}

# ---- main loop --------------------------------------------------------------
GF = 5;          # frames per generation (10 generations per second)
FRAME = 0;
fun refresh() {
    local.x = 0;
    if (FRAME % GF == 0) {
        generation();
        draw_gen();
    }
    FRAME++;
    if (P.active) {
        P.blink = (P.blink + 1) % 50;
        if (CURSOR_R) run_opacity(CURSOR_R, P.blink < 25);
        if (P.active == 1 && P.blink % 10 == 0) {
            if (Plymouth.GetCapslockState()) {
                if (!P.caps) global.CAPS_R = txt_run("err", "caps lock", SX + SW - MARGIN - 9 * FADV, LY2, 6);
                P.caps = 1;
            } else {
                P.caps = 0;
                global.CAPS_R = NULL;
            }
        }
    }
    if (P.err > 0) {
        if (!ERR_R) global.ERR_R = txt_run("err", "wrong. try again.", SX + Math.Int((SW - 17 * FADV) / 2), LY0, 6);
        P.err--;
        if (P.err < 30) run_opacity(ERR_R, P.err / 30);
        if (P.err == 0) global.ERR_R = NULL;
    }
    if (MSG.t > 0) {
        MSG.t--;
        if (MSG.t == 0) global.MSG_R = NULL;
    }
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayQuestionFunction(on_question);
Plymouth.SetDisplayNormalFunction(on_normal);
Plymouth.SetDisplayMessageFunction(on_message);
Plymouth.SetHideMessageFunction(on_hide_message);
