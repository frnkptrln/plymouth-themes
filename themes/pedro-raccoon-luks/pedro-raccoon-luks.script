Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

SW = Window.GetWidth();
SH = Window.GetHeight();
SX = Window.GetX();
SY = Window.GetY();

#==============================================================================
# glyph text engine — bitmap font from PNG atlases (IBM VGA 8x16, CP437)
#==============================================================================
